# Maintainer: zlicdt <xkicdt1@gmail.com>

pkgname=open-orpheus-fork-git
_pkgname=open-orpheus
pkgver=0.16.2.r951.g281899d
pkgrel=1
pkgdesc="An open-source implementation of Netease Cloud Music's Orpheus browser host."
arch=('x86_64')
url="https://github.com/BIGGASSS/open-orpheus"
license=('MIT')
options=('!strip' '!debug')
depends=(
    'alsa-lib'
    'at-spi2-core'
    'gtk3'
    'libdrm'
    'libnotify'
    'libxcb'
    'mesa'
    'nss'
    'xdg-utils'
)
optdepends=('kde-cli-tools: file deletion support (kioclient)')
provides=("open-orpheus-fork=${pkgver}")
conflicts=('open-orpheus-fork')
makedepends=(
    'git'
    'nodejs>=24'
    'pnpm'
    'rust'
    'wasm-bindgen'
)
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${_pkgname}" || return 1
    local version revision hash
    version=$(node -p 'require("./package.json").version.replace(/-/g, ".")') || return 1
    revision=$(git rev-list --count HEAD) || return 1
    hash=$(git rev-parse --short HEAD) || return 1
    printf '%s.r%s.g%s\n' "$version" "$revision" "$hash"
}

prepare() {
    cd "${srcdir}/${_pkgname}"
    pnpm install --frozen-lockfile
}

build() {
    cd "${srcdir}/${_pkgname}"
    pnpm build:modules
    pnpm package -- --arch=x64
}

package() {
    cd "${srcdir}/${_pkgname}"

    install -d "${pkgdir}/opt/${pkgname}"
    cp -a out/open-orpheus-linux-x64/. "${pkgdir}/opt/${pkgname}/"
    chmod 755 "${pkgdir}/opt/${pkgname}"

    install -d "${pkgdir}/usr/bin"
    ln -s "/opt/${pkgname}/open-orpheus" "${pkgdir}/usr/bin/${pkgname}"

    install -Dm644 assets/icon_256.png \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
    install -Dm644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -Dm644 /dev/stdin \
        "${pkgdir}/usr/share/applications/${pkgname}.desktop" <<EOF
[Desktop Entry]
Name=Open Orpheus
Comment=An open-source Netease Cloud Music client
Exec=${pkgname} %U
Icon=${pkgname}
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Network;
StartupWMClass=open-orpheus
EOF
}
