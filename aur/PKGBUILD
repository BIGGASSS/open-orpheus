# Maintainer: zlicdt <xkicdt1@gmail.com>

pkgname=open-orpheus-fork
_pkgname=open-orpheus
pkgver=0.16.2
pkgrel=3
pkgdesc="An open-source implementation of Netease Cloud Music's Orpheus browser host."
arch=('x86_64')
url="https://github.com/BIGGASSS/open-orpheus"
license=('MIT')
options=('!strip' '!debug')
depends=(
    'alsa-lib'
    'at-spi2-core'
    'gtk3'
    'libdrm'
    'libnotify'
    'libxcb'
    'mesa'
    'nss'
    'xdg-utils'
)
optdepends=('kde-cli-tools: file deletion support (kioclient)')
makedepends=(
    'nodejs>=24'
    'pnpm'
    'rust'
    'wasm-bindgen'
)
_commit=9412e93635f0915639a53225bf0c92cf3ac21e4c
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('d6161081d1f00a2886ee876d3cb822e8a894c4d746dc6300e64d29f8761e4c7c')

prepare() {
    cd "${_pkgname}-${_commit}"
    pnpm install --frozen-lockfile
}

build() {
    cd "${_pkgname}-${_commit}"
    pnpm build:modules
    pnpm package -- --arch=x64
}

package() {
    cd "${_pkgname}-${_commit}"

    install -d "${pkgdir}/opt/${pkgname}"
    cp -a out/open-orpheus-linux-x64/. "${pkgdir}/opt/${pkgname}/"
    chmod 755 "${pkgdir}/opt/${pkgname}"

    install -d "${pkgdir}/usr/bin"
    ln -s "/opt/${pkgname}/open-orpheus" "${pkgdir}/usr/bin/${pkgname}"

    install -Dm644 assets/icon_256.png \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
    install -Dm644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -Dm644 /dev/stdin \
        "${pkgdir}/usr/share/applications/${pkgname}.desktop" <<EOF
[Desktop Entry]
Name=Open Orpheus
Comment=An open-source Netease Cloud Music client
Exec=${pkgname} %U
Icon=${pkgname}
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Network;
StartupWMClass=open-orpheus
EOF
}
